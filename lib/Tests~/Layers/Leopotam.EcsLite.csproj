<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the vendored EcsLite sources (lib/third_party/ecslite/src/**) that
    lib/third_party/ecslite/Leopotam.EcsLite.asmdef compiles inside Unity.
    Assembly and root namespace match upstream so `using Leopotam.EcsLite` works
    identically in both builds.

    Third-party, unmodified code: warnings are not treated as errors here because
    fixing them would mean editing vendored sources. See lib/third_party/ecslite/VENDOR.md.
  -->

  <PropertyGroup>
    <AssemblyName>Leopotam.EcsLite</AssemblyName>
    <RootNamespace>Leopotam.EcsLite</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Upstream has no nullable annotations, and annotating vendored code is not
         our call: compile it in the same non-nullable context Unity uses. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(LibThirdPartyDir)ecslite/src/**/*.cs" />
  </ItemGroup>

</Project>
