<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles exactly lib/Runtime/Simulation/**; may reference Shared, Domain
       and the vendored EcsLite - never UnityEngine, R3 or VContainer. -->

  <PropertyGroup>
    <AssemblyName>ProjectSurvive.Core.Simulation</AssemblyName>
    <RootNamespace>ProjectSurvive.Core.Simulation</RootNamespace>
    <!-- Empty by design until Stage 07 (battle ECS world). -->
    <AllowEmptyLayer>true</AllowEmptyLayer>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(LibRuntimeDir)Simulation/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ProjectSurvive.Core.Shared.csproj" />
    <ProjectReference Include="ProjectSurvive.Core.Domain.csproj" />
    <ProjectReference Include="Leopotam.EcsLite.csproj" />
  </ItemGroup>

</Project>
