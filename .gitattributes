# ---------------------------------------------------------------------------
# ProjectSurvive .gitattributes
# Line-ending normalization + Git LFS tracking for large binary assets.
#
# Requires Git LFS:  git lfs install
# ---------------------------------------------------------------------------

# --- Default: normalize text to LF in the repository -----------------------
* text=auto

# --- Source / config text: force LF, never let Windows flip them ----------
*.cs        text eol=lf
*.csx       text eol=lf
*.shader    text eol=lf
*.compute   text eol=lf
*.hlsl      text eol=lf
*.cginc     text eol=lf
*.json      text eol=lf
*.asmdef    text eol=lf
*.asmref    text eol=lf
*.proto     text eol=lf
*.csv       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.xml       text eol=lf
*.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
*.meta      text eol=lf
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.controller text eol=lf
*.anim      text eol=lf
*.mat       text eol=lf
*.inputactions text eol=lf

# --- PowerShell / Windows scripts keep CRLF for native tooling ------------
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# --- Executable / shell scripts keep LF ------------------------------------
*.sh   text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
Dockerfile text eol=lf

# ---------------------------------------------------------------------------
# Git LFS: binary art and audio
# ---------------------------------------------------------------------------
*.png  filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text

# --- Other Unity binary assets worth LFS (safe defaults) -------------------
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.tif  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text
*.cubemap filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.obj  filter=lfs diff=lfs merge=lfs -text
*.dds  filter=lfs diff=lfs merge=lfs -text
*.bmp  filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text
*.ttf  filter=lfs diff=lfs merge=lfs -text
*.otf  filter=lfs diff=lfs merge=lfs -text
*.zip  filter=lfs diff=lfs merge=lfs -text
*.7z   filter=lfs diff=lfs merge=lfs -text
*.dll  filter=lfs diff=lfs merge=lfs -text
*.so   filter=lfs diff=lfs merge=lfs -text
*.a    filter=lfs diff=lfs merge=lfs -text
*.lib  filter=lfs diff=lfs merge=lfs -text
*.bytes filter=lfs diff=lfs merge=lfs -text
