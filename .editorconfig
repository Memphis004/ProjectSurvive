# ---------------------------------------------------------------------------
# ProjectSurvive .editorconfig
# Baseline formatting for all contributors and agents.
# ---------------------------------------------------------------------------

root = true

# --- Defaults ---------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# --- C# ---------------------------------------------------------------------
[*.cs]
indent_size = 4
max_line_length = 120

# Namespaces / usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning

# 'this.' is not required
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Modern language features
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_explicit_tuple_names = true:warning

# var preferences
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion

# Pattern matching / null checking
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:warning

# Unused parameters / code
csharp_style_unused_value_assignment_preference = discard_variable:suggestion
csharp_style_unused_value_expression_statement_preference = discard_variable:suggestion

# Braces
csharp_prefer_braces = when_multiline:warning
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_method_group_conversion = true:warning
csharp_style_prefer_local_over_anonymous_function = true:warning

# --- ProjectSurvive house rules (see AGENTS.md) -----------------------------
# Hot path must not use LINQ / closure capture; keep these as analyzer hints.
dotnet_diagnostic.CA1822.severity = suggestion
# Prefer readonly structs in simulation; a hint, not a gate.
dotnet_diagnostic.CA1051.severity = suggestion

# --- Markdown ---------------------------------------------------------------
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# --- YAML -------------------------------------------------------------------
[*.{yml,yaml}]
indent_size = 2

# --- JSON -------------------------------------------------------------------
[*.json]
indent_size = 2
insert_final_newline = true

# --- Unity serialized assets ------------------------------------------------
[*.{unity,prefab,asset,meta,mat,anim,controller}]
indent_size = 2
trim_trailing_whitespace = false

# --- CSV data tables --------------------------------------------------------
[*.csv]
indent_size = 2
end_of_line = lf

# --- PowerShell -------------------------------------------------------------
[*.{ps1,psm1,psd1}]
end_of_line = crlf
indent_size = 4

# --- Shell / JS tooling -----------------------------------------------------
[*.{sh,mjs,js,ts}]
indent_size = 2

# --- C / shader -------------------------------------------------------------
[*.{shader,hlsl,cginc,compute}]
indent_size = 4

# --- XML / csproj / props ---------------------------------------------------
[*.{xml,csproj,props,targets}]
indent_size = 2

# --- solution files ---------------------------------------------------------
[*.sln]
indent_style = tab
