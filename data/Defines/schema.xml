<?xml version="1.0" encoding="utf-8"?>
<!--
  ProjectSurvive static data schema (Stage 02).

  Verified against the INSTALLED Luban 5.1.0 CLI, not guessed:
    * `<module name="">` holds enums + beans; the table registry lives in
      __tables__.csv with `type: "table"` (Luban 5.x supports per-file schema
      types: XmlSchemaLoader for .xml, ExcelSchemaLoader for .csv).
    * Enum:   <enum name="E"><var name="A" value="1"/></enum>
    * Bean:   <bean name="B"><var name="f" type="..."/></bean>
    * Types:  int | float | bool | string | EnumName
              list#sep=|,Type      (CSV cell holds elements separated by '|')
              Base#ref=TbX         (referential integrity; needs the strict flag)
              int#(range=[a,b])    (Luban value validator)
    * The generated namespace comes from target.topModule ("ProjectSurvive.Config").

  Balance NUMBERS live in the CSV tables under data/tables/, never here.
-->
<module name="">

  <!-- ===================================================================== -->
  <!-- Enums (stable identifiers; string ids in the tables, ints on the wire) -->
  <!-- ===================================================================== -->
  <enum name="Element">
    <var name="None" value="0"/>
    <var name="Fire" value="1"/>
    <var name="Curse" value="2"/>
  </enum>

  <!-- What an offering does when it is used (Stage 11a). A column, not code:
       the amount and the number of uses live beside it in the item row. -->
  <enum name="OfferingEffect">
    <var name="None" value="0"/>
    <var name="Heal" value="1"/>
    <var name="Bia" value="2"/>
  </enum>

  <enum name="ItemCategory">
    <var name="Bag" value="1"/>
    <var name="ArcaneWeapon" value="2"/>
    <var name="Charm" value="3"/>
    <var name="SpellTome" value="4"/>
    <var name="Offering" value="5"/>
    <var name="Familiar" value="6"/>
  </enum>

  <enum name="SkillBehavior">
    <var name="Projectile" value="1"/>
    <var name="Pierce" value="2"/>
    <var name="Aura" value="3"/>
    <var name="Melee" value="4"/>
  </enum>

  <enum name="EnemyRole">
    <var name="Filler" value="1"/>
    <var name="Fast" value="2"/>
    <var name="Elite" value="3"/>
    <var name="Boss" value="4"/>
  </enum>

  <enum name="MovePattern">
    <var name="Chase" value="1"/>
    <var name="Charge" value="2"/>
    <var name="Stationary" value="3"/>
  </enum>

  <!-- The telegraphed attack a ghost runs, if any (Stage 11b).

       None    : contact damage only (walker / boss).
       DashDrain: Krasue - wind up, dash along a line, then drain an aura, then retreat.
       RingVines: Nang Tani - wind up a ring around herself, then lash vines along a line.

       The numbers beside it in the enemy row are the whole attack: no behaviour is
       encoded here, only which of the simulation's small per-kind state machines runs. -->
  <enum name="EnemyAttackPattern">
    <var name="None" value="0"/>
    <var name="DashDrain" value="1"/>
    <var name="RingVines" value="2"/>
  </enum>

  <enum name="SynergyKind">
    <var name="AdjacentPair" value="1"/>
    <var name="SameRow" value="2"/>
    <var name="BagArea" value="3"/>
    <var name="SameColumn" value="4"/>
  </enum>

  <enum name="SynergyStat">
    <var name="Cooldown" value="1"/>
    <var name="Damage" value="2"/>
    <var name="AttackSpeed" value="3"/>
    <var name="Debuff" value="4"/>
  </enum>

  <enum name="Language">
    <var name="Th" value="1"/>
    <var name="En" value="2"/>
  </enum>

  <!-- ===================================================================== -->
  <!-- Beans                                                                -->
  <!-- ===================================================================== -->

  <!-- Localization: the ONLY source of player-facing text (AGENTS rule 5). -->
  <bean name="Localization">
    <var name="key" type="string"/>
    <var name="th" type="string"/>
    <var name="en" type="string"/>
  </bean>

  <!-- Bag piece: opens ActiveSlots on the Board. `footprint` is a PICTURE of the
       shape, one "row" element per line of the picture:

           "XXX|XXX|XXX"  a 3x3 bag      "XXX"      a 1x3 pouch
           "XX.|.XX"      the L-tromino  "XX|XX"    a 2x2 tome

       'X' = the cell is part of the piece, '.' = empty. Parsed in Domain by
       Footprint.TryParse, which normalises the shape to the origin.
       See llmwiki/systems/data-schema.md and docs/adr/0009-footprint-picture-format.md. -->
  <bean name="Bag">
    <var name="id" type="string"/>
    <var name="name_key" type="string#ref=TbLocalization"/>
    <var name="tier" type="int#(range=[1,3])"/>
    <var name="price" type="int"/>
    <var name="weight" type="float"/>
    <var name="footprint" type="list#sep=|,string"/>
  </bean>

  <!-- Cast behaviour of an arcane weapon / familiar. -->
  <bean name="Skill">
    <var name="id" type="string"/>
    <var name="name_key" type="string#ref=TbLocalization"/>
    <var name="behavior" type="SkillBehavior"/>
    <var name="element" type="Element"/>
    <var name="cooldown_seconds" type="float"/>
    <var name="mp_cost" type="int"/>
    <var name="damage" type="int"/>
    <var name="projectile_speed" type="float"/>
    <var name="range" type="float"/>
    <var name="pierce_count" type="int"/>
    <var name="projectile_count" type="int"/>
  </bean>

  <!-- Every non-bag item. `skill_id` is empty for passive pieces, so it is a
       plain string: Luban's ref validator rejects an EMPTY cell, and "no skill"
       is a legitimate value. tools/validate-data.ps1 checks every non-empty
       skill_id / description_key against the target table instead. -->
  <bean name="Item">
    <var name="id" type="string"/>
    <var name="category" type="ItemCategory"/>
    <var name="name_key" type="string#ref=TbLocalization"/>
    <var name="description_key" type="string"/>
    <var name="tier" type="int#(range=[1,3])"/>
    <var name="element" type="Element"/>
    <var name="price" type="int"/>
    <var name="weight" type="float"/>
    <var name="skill_id" type="string"/>
    <var name="tags" type="list#sep=|,string"/>
    <!-- Which board cells the item occupies - the same picture syntax as Bag.
         An item is placeable only where a bag covers every one of its cells, so
         a 2x2 tome and a 2x1 familiar need this to be representable. -->
    <var name="footprint" type="list#sep=|,string"/>

    <!-- Item-local effects (Stage 11a, replacing ADR 0010's deferral).

         A charm adjusts ONE player stat that CombatLoadoutSnapshot already carries;
         the stat and method names are the upgrade vocabulary (Damage, Cooldown,
         MaxHp, ... / Add, Percent, Multiply), checked by the adapter and validator.
         Only a Charm row may set these; every other item leaves them empty.

         An offering says what using it does, how much, how many uses one carried
         piece has, and the HP percentage at or below which the battle spends one
         automatically (0 = never). Only an Offering row may set these. -->
    <var name="charm_stat" type="string"/>
    <var name="charm_method" type="string"/>
    <var name="charm_magnitude" type="float"/>
    <var name="offering_effect" type="OfferingEffect"/>
    <var name="offering_amount" type="int"/>
    <var name="offering_uses" type="int"/>
    <var name="offering_auto_hp_percent" type="int"/>
  </bean>

  <!-- Elemental status, one row per element (Stage 11a). A hit whose skill carries
       an element applies the row whose `element` matches: the damage per application,
       how often it is applied, how long it lasts and how many applications stack are
       all data. `max_stacks = 1` is the refresh rule; a higher value adds one stack per
       application up to the cap. This replaces ADR 0017's "re-use the skill's damage"
       interim rule. -->
  <bean name="Status">
    <var name="id" type="string"/>
    <var name="element" type="Element"/>
    <var name="damage_per_tick" type="int"/>
    <var name="tick_interval_seconds" type="float"/>
    <var name="duration_seconds" type="float"/>
    <var name="max_stacks" type="int#(range=[1,99])"/>
  </bean>

  <!-- Combo rule. Matching is by item TAG, so a rule covers a whole family. -->
  <bean name="Synergy">
    <var name="id" type="string"/>
    <var name="name_key" type="string#ref=TbLocalization"/>
    <var name="kind" type="SynergyKind"/>
    <var name="tag_a" type="string"/>
    <var name="tag_b" type="string"/>
    <var name="stat" type="SynergyStat"/>
    <var name="value_percent" type="float"/>
    <var name="max_stacks" type="int#(range=[1,5])"/>
  </bean>

  <!-- Merge is same-id + tier+1, max tier from `constant`. A recipe targets an
       item OR a bag; exactly one of the two ids is set and both are validated by
       tools/validate-data.ps1 (a `#ref` cannot express "one of two, the other
       empty" because an empty ref cell is an error). -->
  <bean name="MergeRecipe">
    <var name="id" type="string"/>
    <var name="item_id" type="string"/>
    <var name="bag_id" type="string"/>
    <var name="from_tier" type="int#(range=[1,3])"/>
    <var name="to_tier" type="int#(range=[1,3])"/>
  </bean>

  <!-- One upgrade choice offered when two equal pieces fold (Stage 09f).

       The condition is a category OR a tag, and exactly one of the two is set -
       the same "one of two, the other empty" shape `merge_recipe` uses, because a
       `#ref` cannot express an optional reference. `category` holds an
       ItemCategory NAME ("ArcaneWeapon"); `tag` holds an item tag. The whole
       selection rule lives in Domain (UpgradePool): every variant whose
       (category, from_tier) or (tag, from_tier) matches the piece is a candidate,
       and the pool is either empty - the pair folds immediately, as before - or
       big enough for `constant.upgrade_choice_count` choices. -->
  <bean name="UpgradeVariant">
    <var name="id" type="string"/>
    <var name="category" type="string"/>
    <var name="tag" type="string"/>
    <var name="from_tier" type="int#(range=[1,3])"/>
    <var name="to_tier" type="int#(range=[1,3])"/>
    <var name="name_key" type="string#ref=TbLocalization"/>
    <var name="weight" type="int"/>
  </bean>

  <!-- One stat change of a variant. `stat` and `method` are NAMES, not enums, so
       that a typo is a validator finding with a row to point at instead of a Luban
       parse error: the vocabulary is the one the battle loadout actually carries
       (UpgradeStat / UpgradeMethod in Domain/Config/UpgradeStats.cs) and
       tools/validate-data.ps1 rejects a name outside it. A variant with no
       modifier row changes nothing, which is also a finding. -->
  <bean name="UpgradeVariantModifier">
    <var name="id" type="string"/>
    <var name="variant_id" type="string#ref=TbUpgradeVariant"/>
    <var name="stat" type="string"/>
    <var name="method" type="string"/>
    <var name="magnitude" type="float"/>
  </bean>

  <bean name="Enemy">
    <var name="id" type="string"/>
    <var name="name_key" type="string#ref=TbLocalization"/>
    <var name="role" type="EnemyRole"/>
    <var name="max_hp" type="int"/>
    <var name="move_speed" type="float"/>
    <var name="contact_damage" type="int"/>
    <var name="attack_cooldown_seconds" type="float"/>
    <var name="move_pattern" type="MovePattern"/>
    <var name="is_elite" type="bool"/>
    <var name="is_boss" type="bool"/>
    <var name="boss_phase2_hp_percent" type="float"/>
    <!-- Bia one kill of this enemy pays, carried by the pickup it drops. Zero is a
         legal value (a ghost that pays nothing); a negative one is not. Stage 07b:
         every row must name its own value so a boss and a filler can differ. -->
    <var name="drop_value" type="int"/>

    <!-- Telegraphed attack (Stage 11b). Every number is here, never in code.

         A shape is decided by the two length columns: `attack_length = 0` is a CIRCLE
         centred on the ghost with `attack_radius`, and a positive length is a LINE from
         the ghost along its aim with `attack_radius` as the half-width. The telegraph
         event carries the resolved shape, radius, length and angle, so Presentation
         draws what the rule used rather than re-deriving it.

         `attack_seconds` is the strike window (a dash's travel time); `follow_up_*` is
         the second attack of the same cycle (Krasue's drain, Nang Tani's vines) and
         `retreat_*` the step back before the cooldown. Zero means "this stage does not
         happen", which is how one struct describes both ghosts. -->
    <var name="attack_pattern" type="EnemyAttackPattern"/>
    <var name="attack_range" type="float"/>
    <var name="attack_telegraph_seconds" type="float"/>
    <var name="attack_seconds" type="float"/>
    <var name="attack_damage" type="int"/>
    <var name="attack_radius" type="float"/>
    <var name="attack_length" type="float"/>
    <var name="follow_up_telegraph_seconds" type="float"/>
    <var name="follow_up_seconds" type="float"/>
    <var name="follow_up_damage" type="int"/>
    <var name="follow_up_radius" type="float"/>
    <var name="follow_up_length" type="float"/>
    <var name="follow_up_tick_seconds" type="float"/>
    <var name="retreat_seconds" type="float"/>
    <var name="retreat_speed" type="float"/>
  </bean>

  <!-- `index` is the 1-based run order of the floor. The shop pool bands and the
       "every floor has a wave" rule are checked against it, so it must be
       explicit rather than inferred from the id string. -->
  <bean name="Floor">
    <var name="id" type="string"/>
    <var name="index" type="int#(range=[1,20])"/>
    <var name="name_key" type="string#ref=TbLocalization"/>
    <var name="duration_seconds" type="float"/>
    <var name="is_boss" type="bool"/>
    <!-- Empty for a normal floor; checked by tools/validate-data.ps1 when set. -->
    <var name="boss_enemy_id" type="string"/>
  </bean>

  <bean name="Wave">
    <var name="id" type="string"/>
    <var name="floor_id" type="string#ref=TbFloor"/>
    <var name="enemy_id" type="string#ref=TbEnemy"/>
    <var name="start_time_seconds" type="float"/>
    <var name="end_time_seconds" type="float"/>
    <var name="spawn_count" type="int"/>
    <var name="spawn_interval_seconds" type="float"/>
    <var name="is_elite" type="bool"/>
  </bean>

  <!-- A shop pool row offers ONE item or ONE bag, weighted, over a floor range.
       Exactly one of item_id / bag_id is set (checked by validate-data.ps1). -->
  <bean name="ShopPool">
    <var name="id" type="string"/>
    <var name="floor_min" type="int"/>
    <var name="floor_max" type="int"/>
    <var name="item_id" type="string"/>
    <var name="bag_id" type="string"/>
    <var name="weight" type="int"/>
  </bean>

  <!-- Singleton rows (mode=one). -->
  <bean name="Economy">
    <var name="start_bia" type="int"/>
    <var name="shop_slot_count" type="int"/>
    <var name="refresh_base_cost" type="int"/>
    <var name="refresh_cost_increment" type="int"/>
    <var name="sell_back_percent" type="int"/>
    <var name="heal_percent_on_clear" type="int"/>
    <var name="chest_slots" type="int"/>
    <!-- Flat bia paid once for clearing a floor (Stage 07b). It belongs to the run's
         settlement, not to the battle: a loss pays nothing, and the field pickups are
         separate (enemy.drop_value). -->
    <var name="clear_reward_bia" type="int"/>
  </bean>

  <bean name="Constant">
    <var name="board_width" type="int"/>
    <var name="board_height" type="int"/>
    <var name="min_cooldown_seconds" type="float"/>
    <var name="max_speed_penalty_percent" type="int"/>
    <!-- Percent of move speed lost per unit of bag weight. Stage 04 authored only
         the cap (max_speed_penalty_percent); the slope its consumer needs landed
         here with Stage 05 (AGENTS rule 5 - no balance number in code). -->
    <var name="weight_speed_percent_per_unit" type="int"/>
    <var name="pickup_radius" type="float"/>
    <var name="max_hp" type="int"/>
    <var name="max_mp" type="int"/>
    <var name="focus_per_second" type="float"/>
    <var name="move_speed" type="float"/>
    <var name="max_tier" type="int#(range=[1,3])"/>
    <!-- How many upgrade choices a merge offers (Stage 09f). A pool that exists
         but is smaller than this cannot fill the chooser, so the data validator
         requires every (piece, tier step) pool to be empty or at least this big. -->
    <var name="upgrade_choice_count" type="int"/>
    <!-- Stage 07c: the end-of-floor sweep. A win enters a short sweep before the floor
         result is produced, so the drops still on the ground are not lost: every pickup
         drifts toward the player at magnet_speed (world units per second) and is
         collected when it arrives. sweep_timeout_seconds caps the wait; at the cap
         whatever is left is collected at once, so the sweep always ends. Both are
         balance numbers, so they live here and not in code. -->
    <var name="magnet_speed" type="float"/>
    <var name="sweep_timeout_seconds" type="float"/>
  </bean>

</module>
